# CSP stays report-only for one week after deployment. Check browser console
# violations on the main page and 404 page, then switch this header to
# Content-Security-Policy after resolving any real violations.
# includeSubDomains waits for a complete HTTPS subdomain inventory.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  ! Access-Control-Allow-Origin
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-8bme1Os2eEJ1LuO5EmxsmoKEuzFRQuiWtJzhRbeFwfE='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-src 'none'
